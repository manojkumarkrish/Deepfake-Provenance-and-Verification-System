{
  "manifest_version": 3,
  "name": "Deepfake Defense & Provenance Verifier",
  "version": "1.0.0",
  "description": "Real-time perceptual hash & deepfake analysis overlay for web media",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deepfake Defense System"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}